# Copy to .env (git-ignored) and replace EVERY value before any real deployment.
# Generate keys with:  openssl rand -base64 32   (JWT: openssl rand -base64 48)

ASPNETCORE_ENVIRONMENT=Production
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_DB=circuledger
POSTGRES_USER=circuledger
POSTGRES_PASSWORD=change-me-postgres

JWT_SIGNING_KEY=cE+ZZW832lho5KKUqgIPxnkTuiPApgVd6dWFEBISld3DVRNUcX6eDP4Al7fSIZj7
